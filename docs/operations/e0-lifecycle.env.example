# Copy to $XDG_CONFIG_HOME/floppylm/e0-lifecycle.env (or %E/floppylm/e0-lifecycle.env
# for the user unit). The unit template loads this after xbox.env.
# Values here override xbox.env for the same key. Leave a key unset to use the
# documented default or to omit the flag so the companion tool decides.
# See e0-console-lifecycle.md.

# Path to xbox-gpu-training scripts/e0_console_lifecycle.py
# XGPU_E0_CONSOLE_LIFECYCLE=

# Host heartbeat while a campaign still owns work (seconds). Default 300.
# XGPU_E0_HOST_HEARTBEAT_SECONDS=300

# How long teardown waits for the process to leave the list. Omit for the tool default.
# XGPU_E0_TEARDOWN_WAIT_SECONDS=

# Refuse to start when idle-gpu --when before reports an orphan. Default true.
# XGPU_E0_REFUSE_ORPHAN=1

# Process / package identity. Omit to use the campaign package / tool detection.
# XGPU_E0_PACKAGE=
# XGPU_E0_APP_IMAGE=
# XGPU_E0_PID=

# Idle-GPU detection. Omit for generic adapter/engine detection in the tool.
# XGPU_E0_GPU_ADAPTER=
# XGPU_E0_GPU_ENGINE=
# XGPU_E0_GPU_ENGINE_PERCENT=
# XGPU_E0_IDLE_CPU_PERCENT=

# Optional JSON overlay (same keys as campaign.json console_lifecycle.config)
# FLOPPYLM_E0_LIFECYCLE_CONFIG=

# Device Portal. Prefer UWP_DEVICE_URL; XBOX_IP/XBOX_PORT remain aliases.
# UWP_DEVICE_URL=
# UWP_DEVICE_USER=
# OPENAPPX_DEVICE_PASSWORD=
# OPENAPPX_DEVICE_PIN=
