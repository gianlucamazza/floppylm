# Copy to $XDG_CONFIG_HOME/floppylm/e0-lifecycle.env (or %E/floppylm/e0-lifecycle.env
# for the user unit). The unit template loads this after xbox.env.
# Values here override xbox.env for the same key. Leave a key unset to omit the
# flag so xbox-gpu-training#46 defaults apply. Names match docs/e0/lifecycle.md.
# See e0-console-lifecycle.md.

# Path to xbox-gpu-training scripts/e0_console_lifecycle.py (FloppyLM)
# XGPU_E0_CONSOLE_LIFECYCLE=

# Host / app idle (tool defaults: 1800 / 30 / 1800 / 1)
# XGPU_IDLE_EXIT_SECONDS=
# XGPU_HEARTBEAT_INTERVAL_SECONDS=
# XGPU_HEARTBEAT_STALE_SECONDS=
# XGPU_POLL_INTERVAL_SECONDS=

# Idle-GPU detection (tool defaults: 90% / 3 / 1s / all engines / 1% CPU)
# XGPU_GPU_THRESHOLD_PERCENT=
# XGPU_GPU_SAMPLE_COUNT=
# XGPU_GPU_SAMPLE_INTERVAL_SECONDS=
# XGPU_GPU_ENGINES=
# XGPU_IDLE_CPU_PERCENT=

# Teardown (tool default 60s)
# XGPU_TEARDOWN_WAIT_SECONDS=

# Process / package identity. Omit for the tool default image xgpue0.exe
# and terminate-by package,pid. Package falls back to the campaign record.
# XGPU_PROCESS_IMAGES=
# XGPU_E0_PACKAGE=
# XGPU_PACKAGE_FAMILY=
# XGPU_TERMINATE_BY=

# Refuse to start when idle-gpu --when before reports an orphan (FloppyLM).
# XGPU_E0_REFUSE_ORPHAN=1

# Optional JSON overlay (same keys as campaign.json console_lifecycle.config)
# FLOPPYLM_E0_LIFECYCLE_CONFIG=

# Device Portal. Password is never a CLI flag. Prefer XGPU_* names; aliases
# UWP_DEVICE_URL / UWP_DEVICE_USER / OPENAPPX_DEVICE_PASSWORD / OPENAPPX_DEVICE_PIN
# and XBOX_IP / XBOX_USER / XBOX_PASS still map onto them.
# XGPU_PORTAL_URL=
# XGPU_PORTAL_PORT=
# XGPU_PORTAL_USER=
# XGPU_PORTAL_PASSWORD=
# XGPU_PORTAL_TLS_VERIFY=
# XGPU_PORTAL_TLS_PIN=
# XGPU_PORTAL_CREDENTIALS=
